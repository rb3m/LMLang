#!/bin/sh
# lm: run the LM toolchain from any directory. Symlink this file onto PATH
# (e.g. ln -s /path/to/LMLang/bin/lm ~/.local/bin/lm); it finds its checkout
# through the symlink. LM_PYTHON picks the interpreter (default python3).
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec "${LM_PYTHON:-python3}" -m lm "$@"
