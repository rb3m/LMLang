(scenarios
  (scenario "Subprocess captures separate output streams"
    (status proposed)
    (why "A child can report ordinary output and diagnostics independently.")
    (allow proc.run)
    (run proc.run (list "/bin/sh" "-c" "printf hello; printf warning >&2") "" None (list))
    (expect (new proc.Result (exit (proc.Exited 0)) (stdout "hello") (stderr "warning"))))
  (scenario "Subprocess nonzero exit is a result"
    (status proposed)
    (why "A tool returning status seven is a normal result the caller can inspect.")
    (allow proc.run)
    (run proc.run (list "/bin/sh" "-c" "exit 7") "" None (list))
    (expect (new proc.Result (exit (proc.Exited 7)) (stdout "") (stderr ""))))
  (scenario "Subprocess signal is a result"
    (status proposed)
    (why "Termination by SIGTERM remains distinguishable from an exit status.")
    (allow proc.run)
    (run proc.run (list "/bin/sh" "-c" "kill -TERM $$") "" None (list))
    (expect (new proc.Result (exit (proc.Signaled 15)) (stdout "") (stderr ""))))
  (scenario "Subprocess receives exactly the explicit environment"
    (status proposed)
    (why "Host credentials and ambient environment settings cannot leak implicitly.")
    (allow proc.run)
    (run proc.run (list "/usr/bin/env") "" None (list (pair "ONLY" "passed")))
    (expect (new proc.Result (exit (proc.Exited 0)) (stdout "ONLY=passed\n") (stderr ""))))
  (scenario "Subprocess uses the requested working directory"
    (status proposed)
    (why "A caller chooses the directory used by its child.")
    (allow proc.run)
    (run proc.run (list "/bin/sh" "-c" "pwd -P") "" (Some "/") (list))
    (expect (new proc.Result (exit (proc.Exited 0)) (stdout "/\n") (stderr ""))))
  (scenario "Subprocess rejects invalid UTF-8 output"
    (status proposed)
    (why "Invalid text fails with a fixed category instead of losing bytes silently.")
    (allow proc.run)
    (run proc.run (list "/bin/sh" "-c" "printf '\\377'") "" None (list))
    (expect-fail proc.ProcError "invalid-utf8"))
  (scenario "Subprocess bounds captured output"
    (status proposed)
    (why "An excessive output stream fails without returning a partial result.")
    (allow proc.run)
    (run proc.run (list "/bin/sh" "-c" "/usr/bin/head -c 8388609 /dev/zero") "" None (list))
    (expect-fail proc.ProcError "limit")))
