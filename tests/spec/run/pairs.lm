(module pairs
  (purpose
    "Pair semantics, first-class pair, accessors, list head/tail/last, zip, map to/from list.")
  (use list map pair str)
  (fn check-eq
    (purpose "Structural equality on pairs.")
    (sig (a (Pair Int Str)) (b (Pair Int Str)) -> Bool)
    (example ((pair 1 "x") (pair 1 "x")) => true)
    (example ((pair 1 "x") (pair 1 "y")) => false)
    (example ((pair 1 "x") (pair 2 "x")) => false)
    (body (= a b)))
  (fn check-neq
    (purpose "Structural inequality on pairs.")
    (sig (a (Pair Int Str)) (b (Pair Int Str)) -> Bool)
    (example ((pair 1 "x") (pair 2 "y")) => true)
    (example ((pair 1 "x") (pair 1 "x")) => false)
    (body (!= a b)))
  (fn list-head
    (purpose "Call list.head on empty and non-empty lists.")
    (sig (xs (List Int)) -> (Opt Int))
    (example ((list 10 20 30)) => (Some 10))
    (example ((list 5)) => (Some 5))
    (example ((list)) => None)
    (body (list.head xs)))
  (fn list-last
    (purpose "Call list.last on empty and non-empty lists.")
    (sig (xs (List Int)) -> (Opt Int))
    (example ((list 10 20 30)) => (Some 30))
    (example ((list 5)) => (Some 5))
    (example ((list)) => None)
    (body (list.last xs)))
  (fn list-tail
    (purpose "Call list.tail on empty and non-empty lists.")
    (sig (xs (List Int)) -> (Opt (List Int)))
    (example ((list 10 20 30)) => (Some (list 20 30)))
    (example ((list 5)) => (Some (list)))
    (example ((list)) => None)
    (body (list.tail xs)))
  (fn list-zip
    (purpose "Call list.zip with equal length lists.")
    (sig (xs (List Int)) (ys (List Str)) -> (List (Pair Int Str)))
    (example ((list 1 2 3) (list "x" "y" "z")) => (list (pair 1 "x") (pair 2 "y") (pair 3 "z")))
    (example ((list 1) (list "a")) => (list (pair 1 "a")))
    (example ((list) (list)) => (list))
    (body (list.zip xs ys)))
  (fn make-p
    (purpose "Construct a pair.")
    (sig (x Int) (y Str) -> (Pair Int Str))
    (example (1 "a") => (pair 1 "a"))
    (example (42 "hello") => (pair 42 "hello"))
    (body (pair x y)))
  (fn map-from-list
    (purpose "Build map from list of pairs, with last-wins on duplicates.")
    (sig (ps (List (Pair Str Int))) -> (Map Str Int))
    (example ((list (pair "a" 1) (pair "b" 2) (pair "a" 99))) => (mapof ("a" 99) ("b" 2)))
    (example ((list (pair "k" 1) (pair "k" 2) (pair "k" 3))) => (mapof ("k" 3)))
    (example ((list)) => (mapof))
    (body (map.from-list ps)))
  (fn map-to-list
    (purpose "Convert map to list of pairs in key order.")
    (sig (m (Map Str Int)) -> (List (Pair Str Int)))
    (example ((mapof ("c" 3) ("a" 1) ("b" 2))) => (list (pair "a" 1) (pair "b" 2) (pair "c" 3)))
    (example ((mapof)) => (list))
    (body (map.to-list m)))
  (fn map2-pair
    (purpose "Use pair as a first-class function value in list.map2.")
    (sig (xs (List Int)) (ys (List Str)) -> (List (Pair Int Str)))
    (example ((list 1 2) (list "a" "b")) => (list (pair 1 "a") (pair 2 "b")))
    (example ((list) (list)) => (list))
    (body (list.map2 xs ys pair)))
  (fn nested-p
    (purpose "Destructure nested pairs.")
    (sig (p (Pair (Pair Int Int) Int)) -> Int)
    (example ((pair (pair 1 2) 3)) => 6)
    (example ((pair (pair 10 20) 30)) => 60)
    (body (match p ((pair p1 c) (match p1 ((pair a b) (+ (+ a b) c)))))))
  (fn unpack-p
    (purpose "Destructure a pair in match.")
    (sig (p (Pair Int Str)) -> Int)
    (example ((pair 10 "abc")) => 13)
    (example ((pair 0 "")) => 0)
    (body (match p ((pair n s) (+ n (str.length s))))))
  (fn use-first
    (purpose "Call pair.first.")
    (sig (p (Pair Int Str)) -> Int)
    (example ((pair 99 "z")) => 99)
    (example ((pair -5 "foo")) => -5)
    (body (pair.first p)))
  (fn use-second
    (purpose "Call pair.second.")
    (sig (p (Pair Int Str)) -> Str)
    (example ((pair 99 "z")) => "z")
    (example ((pair 0 "bar")) => "bar")
    (body (pair.second p)))
  (fn use-swap
    (purpose "Call pair.swap.")
    (sig (p (Pair Int Str)) -> (Pair Str Int))
    (example ((pair 1 "a")) => (pair "a" 1))
    (example ((pair 2 "b")) => (pair "b" 2))
    (body (pair.swap p))))
