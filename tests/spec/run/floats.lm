(module floats
  (purpose "Float semantics (ADR-039): rounding, ties, subnormals, -0.0, conversions, text.")
  (use float math str)
  (type Reading (rec (label Str) (value Float)))
  (fn add
    (purpose "Every + rounds to nearest binary64, ties to even.")
    (sig (a Float) (b Float) -> Float)
    (example (0.1 0.2) => 0.30000000000000004)
    (example (1.0 1.1102230246251565e-16) => 1.0)
    (example (1.0000000000000002 1.1102230246251565e-16) => 1.0000000000000004)
    (example (1000000000000000.0 0.3) => 1000000000000000.2)
    (example (1.7976931348623157e+308 1.0) => 1.7976931348623157e+308)
    (body (+ a b)))
  (fn as-text
    (purpose "Canonical text: positional for exponents in [-4, 16), else d.ddde+XX.")
    (sig (x Float) -> Str)
    (example (100.0) => "100.0")
    (example (0.0001) => "0.0001")
    (example (1e-05) => "1e-05")
    (example (1e+16) => "1e+16")
    (example (9999999999999998.0) => "9999999999999998.0")
    (example (1.5e-07) => "1.5e-07")
    (example (1.2345678901234567e+19) => "1.2345678901234567e+19")
    (example (-2.5) => "-2.5")
    (example (5e-324) => "5e-324")
    (example (1.7976931348623157e+308) => "1.7976931348623157e+308")
    (body (str.from-float x)))
  (fn div
    (purpose "Float division by a nonzero divisor; never fails DivZero.")
    (sig (a Float) (b Float) -> Float)
    (example (1.0 3.0) => 0.3333333333333333)
    (example (0.0 -1.0) => 0.0)
    (example (-1.0 4.0) => -0.25)
    (body (/ a b)))
  (fn half
    (purpose "Subnormals are kept; underflow rounds to zero (ties to even).")
    (sig (x Float) -> Float)
    (example (2.2250738585072014e-308) => 1.1125369292536007e-308)
    (example (5e-324) => 0.0)
    (example (1e-323) => 5e-324)
    (body (/ x 2.0)))
  (fn mul
    (purpose "Every * rounds; a negative zero result is normalized to 0.0.")
    (sig (a Float) (b Float) -> Float)
    (example (-1.0 0.0) => 0.0)
    (example (-5e-324 0.5) => 0.0)
    (example (0.1 3.0) => 0.30000000000000004)
    (example (-5e-324 1.0) => -5e-324)
    (body (* a b)))
  (fn neg-zero-text
    (purpose "-0.0 never exists, so it prints 0.0.")
    (sig (a Float) (b Float) -> Str)
    (example (-1.0 0.0) => "0.0")
    (example (0.0 0.0) => "0.0")
    (body (str.from-float (* a b))))
  (fn order
    (purpose "Comparisons and exact equality.")
    (sig (a Float) (b Float) -> (List Bool))
    (example (0.1 0.2) => (list true true false false false))
    (example (0.0 0.0) => (list false true false true true))
    (body (list (< a b) (<= a b) (> a b) (>= a b) (= a b))))
  (fn parse
    (purpose "str.to-float: decimal text only; malformed or non-finite gives None.")
    (sig (s Str) -> (Opt Float))
    (example ("1.") => (Some 1.0))
    (example (".5") => (Some 0.5))
    (example ("+1") => (Some 1.0))
    (example ("-1e-400") => (Some 0.0))
    (example ("1.7976931348623157e308") => (Some 1.7976931348623157e+308))
    (example ("1.7976931348623159e308") => None)
    (example ("1_0") => None)
    (example ("0x10") => None)
    (example ("inf") => None)
    (example ("-nan") => None)
    (example ("") => None)
    (example ("1e") => None)
    (example ("0.1") => (Some 0.1))
    (body (str.to-float s)))
  (fn reading
    (purpose "Floats inside records and variants print canonically.")
    (sig (x Float) -> (Opt Reading))
    (example (2.5) => (Some (new Reading (label "t") (value 2.5))))
    (body (Some (new Reading (label "t") (value x)))))
  (fn rounding
    (purpose "floor ceil round trunc as Int.")
    (sig (x Float) -> (List Int))
    (example (2.5) => (list 2 3 3 2))
    (example (-2.5) => (list -3 -2 -3 -2))
    (example (0.5) => (list 0 1 1 0))
    (example
      (4503599627370495.5)
      =>
      (list 4503599627370495 4503599627370496 4503599627370496 4503599627370495))
    (example
      (-9.223372036854776e+18)
      =>
      (list -9223372036854775808 -9223372036854775808 -9223372036854775808 -9223372036854775808))
    (body (list (float.floor x) (float.ceil x) (float.round x) (float.trunc x))))
  (fn to-float
    (purpose "float.from-int rounds to nearest, ties to even.")
    (sig (n Int) -> Float)
    (example (9007199254740993) => 9007199254740992.0)
    (example (9007199254740995) => 9007199254740996.0)
    (example (-9223372036854775808) => -9.223372036854776e+18)
    (example (0) => 0.0)
    (body (float.from-int n)))
  (fn total
    (purpose "float.sum folds left from 0.0.")
    (sig (xs (List Float)) -> Float)
    (example ((list 0.1 0.2 0.3)) => 0.6000000000000001)
    (example ((list 1e+16 1.0 1.0)) => 1e+16)
    (body (float.sum xs)))
  (fn trunc-max
    (purpose "The largest Float below 2^63 converts; never compare against from-int(int-max).")
    (sig -> Int)
    (example () => 9223372036854774784)
    (body (float.trunc (float.from-int (- (math.int-max) 1023))))))
