(module date-runtime
  (purpose "Gregorian boundary, strict text, and UTC floor-decomposition regressions.")
  (use date)
  (fn normalize-datetime
    (purpose "Accept exactly canonical UTC text and preserve every millisecond.")
    (sig (s Str) -> Str)
    (example ("1969-12-31T23:59:59.999Z") => "1969-12-31T23:59:59.999Z")
    (example ("0001-01-01T00:00:00.000Z") => "0001-01-01T00:00:00.000Z")
    (example ("9999-12-31T23:59:59.999Z") => "9999-12-31T23:59:59.999Z")
    (example ("2000-02-29T00:00:00.000Z") => "2000-02-29T00:00:00.000Z")
    (example ("1900-02-29T00:00:00.000Z") => "none")
    (example ("2000-02-29T24:00:00.000Z") => "none")
    (example ("2000-02-29T00:60:00.000Z") => "none")
    (example ("2000-02-29T00:00:60.000Z") => "none")
    (example ("2000-02-29T00:00:00.00Z") => "none")
    (example ("2000-02-29T00:00:00.0000Z") => "none")
    (example ("2000-02-29t00:00:00.000Z") => "none")
    (example ("2000-02-29T00:00:00.000z") => "none")
    (example ("2000-02-29T00:00:00.000+00:00") => "none")
    (example ("2000-02-29T00:00:00.000Z\n") => "none")
    (example ("2000-02-29T٠٠:00:00.000Z") => "none")
    (example ("2000-02-29T00:00:00. 00Z") => "none")
    (body (match (date.parse-datetime s) ((Some d) (date.print-datetime d)) (None "none"))))
  (fn render-days
    (purpose "Render a day count, rejecting dates outside years 1 through 9999.")
    (sig (n Int) -> Str)
    (example (-719162) => "0001-01-01")
    (example (2932896) => "9999-12-31")
    (example (-1) => "1969-12-31")
    (example (0) => "1970-01-01")
    (example (-719163) => "none")
    (example (2932897) => "none")
    (example (-9223372036854775808) => "none")
    (example (9223372036854775807) => "none")
    (body (match (date.from-days n) ((Some d) (date.print d)) (None "none"))))
  (fn render-epoch
    (purpose "Render UTC milliseconds, including negative epochs and range endpoints.")
    (sig (n Int) -> Str)
    (example (-1) => "1969-12-31T23:59:59.999Z")
    (example (-86400001) => "1969-12-30T23:59:59.999Z")
    (example (0) => "1970-01-01T00:00:00.000Z")
    (example (-62135596800000) => "0001-01-01T00:00:00.000Z")
    (example (253402300799999) => "9999-12-31T23:59:59.999Z")
    (example (-62135596800001) => "none")
    (example (253402300800000) => "none")
    (example (-9223372036854775808) => "none")
    (example (9223372036854775807) => "none")
    (body (match (date.from-epoch-ms n) ((Some d) (date.print-datetime d)) (None "none"))))
  (fn shift-date
    (purpose "Shift a strict civil date safely, even with extreme offsets.")
    (sig (s Str) (n Int) -> Str)
    (example ("2000-02-28" 1) => "2000-02-29")
    (example ("1900-02-28" 1) => "1900-03-01")
    (example ("2000-02-29" 1) => "2000-03-01")
    (example ("0001-01-01" -1) => "none")
    (example ("9999-12-31" 1) => "none")
    (example ("0001-01-01" -9223372036854775808) => "none")
    (example ("9999-12-31" 9223372036854775807) => "none")
    (example ("2000-01-01" -9223372036854775808) => "none")
    (example ("2000-01-01" 9223372036854775807) => "none")
    (example ("0000-01-01" 0) => "none")
    (example ("1900-02-29" 0) => "none")
    (example ("2000-2-29" 0) => "none")
    (example ("2000-02-29 " 0) => "none")
    (example ("2000-02-29\n" 0) => "none")
    (example ("２０００-02-29" 0) => "none")
    (example ("2000-٠٢-29" 0) => "none")
    (body
      (match
        (date.parse s)
        ((Some d) (match (date.add-days d n) ((Some shifted) (date.print shifted)) (None "none")))
        (None "none")))))
