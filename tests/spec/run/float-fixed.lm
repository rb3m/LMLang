(module float-fixed
  (purpose
    "Fixed decimals round the exact binary64 value half to even, across all finite magnitudes.")
  (use float)
  (fn render
    (purpose "Exact binary value to fixed decimal places, half-even; no negative rounded zero.")
    (sig (x Float) (digits Int) -> Str)
    (example (0.125 2) => "0.12")
    (example (0.375 2) => "0.38")
    (example (9.995 2) => "9.99")
    (example (9.999 2) => "10.00")
    (example (-0.001 2) => "0.00")
    (example (0.0 2) => "0.00")
    (example (-0.001 0) => "0")
    (example (-0.125 2) => "-0.12")
    (example (5e-324 17) => "0.00000000000000000")
    (example
      (1.7976931348623157e+308 0)
      =>
      "")
    (example
      (1.7976931348623157e+308 17)
      =>
      ".00000000000000000")
    (example (2.5 0) => "2")
    (example (3.5 0) => "4")
    (example (0.1 17) => "0.10000000000000001")
    (example (1e+20 2) => "100000000000000000000.00")
    (body (float.fixed x digits))))
