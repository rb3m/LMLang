(module bytes-runtime
  (purpose "Immutable Bytes conversion, indexing and field access.")
  (use bytes)
  (export echo)
  (fn basic
    (purpose "Exercise basic operations, clamping and conversions.")
    (sig -> Bool)
    (example () => true)
    (body
      (let
        ((b (bytesof "00ff80")))
        (and
          (= (bytes.empty) (bytesof ""))
          (= (bytes.size b) 3)
          (= (bytes.at b 1) (Some 255))
          (= (bytes.at b -1) None)
          (= (bytes.at b 3) None)
          (= (bytes.slice b -2 2) (bytesof "00ff"))
          (= (bytes.slice b 1 9223372036854775807) (bytesof "ff80"))
          (= (bytes.slice b 1 -1) (bytes.empty))
          (= (bytes.slice b 9223372036854775807 2) (bytes.empty))
          (= (bytes.concat (bytesof "00") (bytesof "ff80")) b)
          (!= b (bytesof "ff0080"))
          (= (bytes.fill 2 255) (Some (bytesof "ffff")))
          (= (bytes.fill -9223372036854775808 0) (Some (bytes.empty)))
          (= (bytes.fill 0 256) None)
          (= (bytes.fill 1 -1) None)
          (= (bytes.from-list (list 0 255 128)) (Some b))
          (= (bytes.from-list (list)) (Some (bytes.empty)))
          (= (bytes.from-list (list 0 256)) None)
          (= (bytes.from-list (list -1)) None)
          (= (bytes.to-list b) (list 0 255 128))
          (= (bytes.hex b) "00ff80")
          (= (bytes.from-hex "00fF80") (Some b))
          (= (bytes.from-hex "") (Some (bytes.empty)))
          (= (bytes.from-hex "00 ff") None)
          (= (bytes.from-hex "gg") None)
          (= (bytes.from-hex "0") None)
          (= (bytes.from-str "Mé🙂") (bytesof "4dc3a9f09f9982"))
          (= (bytes.to-str (bytesof "4dc3a9f09f9982")) (Some "Mé🙂"))
          (= (bytes.to-str (bytes.empty)) (Some ""))
          (= (bytes.to-str (bytesof "c080")) None)
          (= (bytes.to-str (bytesof "eda080")) None)
          (= (bytes.to-str (bytesof "f09f99")) None)
          (= (bytes.to-str b) None)))))
  (fn echo
    (purpose "Return an external Bytes constant.")
    (sig (b Bytes) -> Bytes)
    (example ((bytesof "")) => (bytesof ""))
    (example ((bytesof "0aFF")) => (bytesof "0aff"))
    (body b))
  (fn fields
    (purpose "Exercise every signed and unsigned field at its boundaries.")
    (sig -> Bool)
    (example () => true)
    (body
      (let
        ((b (bytesof "0000000000")))
        (and
          (= (bytes.u8 (bytesof "00ff000000") 1) (Some 255))
          (= (bytes.u8 b 5) None)
          (= (bytes.u8 b -1) None)
          (= (bytes.put-u8 b 1 255) (Some (bytesof "00ff000000")))
          (= (bytes.put-u8 b 9223372036854775807 255) None)
          (= (bytes.put-u8 b 1 -1) None)
          (= (bytes.put-u8 b 1 256) None)
          (= (bytes.s8 (bytesof "0080000000") 1) (Some -128))
          (= (bytes.s8 b 5) None)
          (= (bytes.s8 b -1) None)
          (= (bytes.put-s8 b 1 -128) (Some (bytesof "0080000000")))
          (= (bytes.put-s8 b 9223372036854775807 -128) None)
          (= (bytes.put-s8 b 1 -129) None)
          (= (bytes.put-s8 b 1 128) None)
          (= (bytes.u16le (bytesof "0034120000") 1) (Some 4660))
          (= (bytes.u16le b 4) None)
          (= (bytes.u16le b -1) None)
          (= (bytes.put-u16le b 1 4660) (Some (bytesof "0034120000")))
          (= (bytes.put-u16le b 9223372036854775807 4660) None)
          (= (bytes.put-u16le b 1 -1) None)
          (= (bytes.put-u16le b 1 65536) None)
          (= (bytes.u16be (bytesof "00ffff0000") 1) (Some 65535))
          (= (bytes.u16be b 4) None)
          (= (bytes.u16be b -1) None)
          (= (bytes.put-u16be b 1 65535) (Some (bytesof "00ffff0000")))
          (= (bytes.put-u16be b 9223372036854775807 65535) None)
          (= (bytes.put-u16be b 1 -1) None)
          (= (bytes.put-u16be b 1 65536) None)
          (= (bytes.s16le (bytesof "0000800000") 1) (Some -32768))
          (= (bytes.s16le b 4) None)
          (= (bytes.s16le b -1) None)
          (= (bytes.put-s16le b 1 -32768) (Some (bytesof "0000800000")))
          (= (bytes.put-s16le b 9223372036854775807 -32768) None)
          (= (bytes.put-s16le b 1 -32769) None)
          (= (bytes.put-s16le b 1 32768) None)
          (= (bytes.s16be (bytesof "00fffe0000") 1) (Some -2))
          (= (bytes.s16be b 4) None)
          (= (bytes.s16be b -1) None)
          (= (bytes.put-s16be b 1 -2) (Some (bytesof "00fffe0000")))
          (= (bytes.put-s16be b 9223372036854775807 -2) None)
          (= (bytes.put-s16be b 1 -32769) None)
          (= (bytes.put-s16be b 1 32768) None)
          (= (bytes.u32le (bytesof "0078563412") 1) (Some 305419896))
          (= (bytes.u32le b 2) None)
          (= (bytes.u32le b -1) None)
          (= (bytes.put-u32le b 1 305419896) (Some (bytesof "0078563412")))
          (= (bytes.put-u32le b 9223372036854775807 305419896) None)
          (= (bytes.put-u32le b 1 -1) None)
          (= (bytes.put-u32le b 1 4294967296) None)
          (= (bytes.u32be (bytesof "00ffffffff") 1) (Some 4294967295))
          (= (bytes.u32be b 2) None)
          (= (bytes.u32be b -1) None)
          (= (bytes.put-u32be b 1 4294967295) (Some (bytesof "00ffffffff")))
          (= (bytes.put-u32be b 9223372036854775807 4294967295) None)
          (= (bytes.put-u32be b 1 -1) None)
          (= (bytes.put-u32be b 1 4294967296) None)
          (= (bytes.s32le (bytesof "0000000080") 1) (Some -2147483648))
          (= (bytes.s32le b 2) None)
          (= (bytes.s32le b -1) None)
          (= (bytes.put-s32le b 1 -2147483648) (Some (bytesof "0000000080")))
          (= (bytes.put-s32le b 9223372036854775807 -2147483648) None)
          (= (bytes.put-s32le b 1 -2147483649) None)
          (= (bytes.put-s32le b 1 2147483648) None)
          (= (bytes.s32be (bytesof "00fffffffe") 1) (Some -2))
          (= (bytes.s32be b 2) None)
          (= (bytes.s32be b -1) None)
          (= (bytes.put-s32be b 1 -2) (Some (bytesof "00fffffffe")))
          (= (bytes.put-s32be b 9223372036854775807 -2) None)
          (= (bytes.put-s32be b 1 -2147483649) None)
          (= (bytes.put-s32be b 1 2147483648) None)
          (= b (bytesof "0000000000")))))))
