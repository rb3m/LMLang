(module mock-proc-env-order
  (purpose "Subprocess scripts detect env-order.")
  (use proc)
  (fn f
    (purpose "Invoke a subprocess under an unmatched script.")
    (sig -> proc.Result)
    (eff proc.run)
    (fails proc.ProcError)
    (example
      ()
      (given (proc (argv "/bin/x") (env "A" "1") (env "B" "2") (exited 0)))
      =>
      (new proc.Result (exit (proc.Exited 0)) (stdout "") (stderr "")))
    (body (proc.run (list "/bin/x") "" None (list (pair "B" "2") (pair "A" "1"))))))
