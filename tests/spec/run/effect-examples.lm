(module effect-examples
  (purpose "Hermetic examples cover input, output, clocks, random and local values.")
  (use env fs io rand time)
  (type Answer (sum Ready))
  (error Stopped)
  (fn arguments
    (purpose "Read fake command arguments.")
    (sig -> (List Str))
    (eff io.in)
    (example () (given (args "a" "b")) => (list "a" "b"))
    (example () (given) => (list))
    (body (io.args)))
  (fn clocks
    (purpose "Both clocks stay frozen at one instant.")
    (sig -> (List Int))
    (eff time.now)
    (example () (given) => (list 0 0 0))
    (example () (given (now-ms -7)) => (list -7 -7 -7))
    (body (list (time.now-ms) (time.mono-ms) (time.now-ms))))
  (fn echo
    (purpose "Echo all fake input to both streams.")
    (sig -> Unit)
    (eff io.in io.out)
    (fails io.IoError)
    (example () (given (stdin "hello")) => unit (out "hello\n") (err "hello\n"))
    (body (let ((text (io.read-all))) (do (io.print text) (io.eprint text)))))
  (fn environment
    (purpose "Read fake environment without consulting the host.")
    (sig -> (Opt Str))
    (eff env.read)
    (example () (given (env "HOME" "fake")) => (Some "fake"))
    (example () (given) => None)
    (body (env.lookup "HOME")))
  (fn local-result
    (purpose "Example values retain module-local resolution.")
    (sig (answer Answer) -> Answer)
    (eff env.read)
    (example (Ready) (given) => Ready)
    (body (let ((unused (env.lookup "K"))) answer)))
  (fn random
    (purpose "Each example gets the same fresh random stream.")
    (sig -> Int)
    (eff rand)
    (example () (given) => 35)
    (example () (given (seed 0)) => 35)
    (example () (given (seed 7)) => 87)
    (body (rand.int 0 99)))
  (fn write-then-fail
    (purpose "Check fake files even after an expected recoverable failure.")
    (sig -> Unit)
    (eff fs.write)
    (fails Stopped fs.IoError)
    (example () (given) => (fail Stopped) (file "x.txt" "saved"))
    (body (do (fs.write "x.txt" "saved") (fail Stopped)))))
