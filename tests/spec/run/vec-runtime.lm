(module vec-runtime
  (purpose "Persistent vector semantics and trie boundaries.")
  (use list opt vec)
  (type (Box a) (rec (item a)))
  (type Row (rec (label Str) (score Int)))
  (type (Rows a) (Vec (Box a)))
  (error First)
  (error Second)
  (fn alias
    (purpose "Generic aliases can contain vectors of generic records.")
    (sig (v (Rows Int)) -> (Rows Int))
    (example ((vecof (new Box (item 7)))) => (vecof (new Box (item 7))))
    (body v))
  (fn boundaries
    (purpose "Bulk traversal, persistence and push/pop at tail and trie-height boundaries.")
    (sig (n Int) -> Bool)
    (example (0) => true)
    (example (1) => true)
    (example (31) => true)
    (example (32) => true)
    (example (33) => true)
    (example (1024) => true)
    (example (1025) => true)
    (example (1056) => true)
    (example (1057) => true)
    (example (32768) => true)
    (example (32769) => true)
    (example (32800) => true)
    (example (32801) => true)
    (body
      (let
        (
          (xs (list.range 0 n))
          (v (vec.from-list xs))
          (pushed (vec.push v n))
          (popped (opt.unwrap-or (vec.pop v) (vec.empty)))
          (updated (opt.unwrap-or (vec.set v 0 -1) v))
          (put-updated (try (vec.put v 0 -2) (catch OutOfRange () v))))
        (and
          (= (vec.size v) n)
          (= v (vec.tabulate n (lam ((i Int)) i)))
          (= v (list.fold xs (vec.empty) vec.push))
          (= (vec.to-list v) xs)
          (= (vec.fold v 0 +) (list.sum xs))
          (=
            (vec.to-list (vec.map v (lam ((x Int)) (+ x 1))))
            (list.map xs (lam ((x Int)) (+ x 1))))
          (= (vec.pop pushed) (Some v))
          (= (vec.last pushed) (Some n))
          (= (vec.to-list popped) (list.take xs (- n 1)))
          (= (vec.at v -1) None)
          (= (vec.at v n) None)
          (= (vec.set v -1 9) None)
          (= (vec.set v n 9) None)
          (= (vec.to-list v) xs)
          (if
            (> n 0)
            (and
              (= (vec.at updated 0) (Some -1))
              (= (vec.at put-updated 0) (Some -2))
              (= (vec.at v 0) (Some 0))
              (= (vec.push popped (- n 1)) v)
              (= (vec.last v) (Some (- n 1))))
            (and (= (vec.pop v) None) (= (vec.last v) None)))))))
  (fn literal
    (purpose "Vector literals preserve their ordered elements.")
    (sig (v (Vec Int)) -> (Vec Int))
    (example ((vecof)) => (vecof))
    (example ((vecof 1 2 3)) => (vecof 1 2 3))
    (body v))
  (fn literal-order
    (purpose "Literal elements evaluate from left to right.")
    (sig -> (Vec Int))
    (fails First Second)
    (example () => (fail First))
    (body (vecof (fail First) (fail Second))))
  (fn nested
    (purpose "Vectors nest with vectors and instantiated generic records.")
    (sig -> (Vec (Vec (Box (Vec Row)))))
    (example () => (vecof (vecof (new Box (item (vecof (new Row (label "a") (score 7))))))))
    (body (vecof (vecof (new Box (item (vecof (new Row (label "a") (score 7)))))))))
  (fn nth-failure
    (purpose "Checked vector indexing fails without wrapping invalid indices.")
    (sig (v (Vec Int)) (i Int) -> Int)
    (fails OutOfRange)
    (example ((vecof) 0) => (fail OutOfRange))
    (example ((vecof 1) -1) => (fail OutOfRange))
    (example ((vecof 1) 1) => (fail OutOfRange))
    (example ((vecof 1) 0) => 1)
    (body (vec.nth v i)))
  (fn proven-nth
    (purpose "A literal vector index is safe under a binding-specific size fact.")
    (sig (v (Vec Int)) -> Int)
    (requires (> (vec.size v) 0))
    (example ((vecof 7)) => 7)
    (body (vec.nth v 0)))
  (fn proven-put
    (purpose "A literal vector replacement is safe under a size fact.")
    (sig (v (Vec Int)) -> (Vec Int))
    (requires (> (vec.size v) 0))
    (example ((vecof 7)) => (vecof 9))
    (body (vec.put v 0 9)))
  (fn put-failure
    (purpose "Checked vector replacement fails without wrapping invalid indices.")
    (sig (v (Vec Int)) (i Int) -> (Vec Int))
    (fails OutOfRange)
    (example ((vecof) 0) => (fail OutOfRange))
    (example ((vecof 1) -1) => (fail OutOfRange))
    (example ((vecof 1) 1) => (fail OutOfRange))
    (example ((vecof 1) 0) => (vecof 9))
    (body (vec.put v i 9))))
