(module mock-proc-leftover
  (purpose "Subprocess scripts detect leftover.")
  (use proc)
  (fn f
    (purpose "Invoke a subprocess under an unmatched script.")
    (sig -> proc.Result)
    (eff proc.run)
    (fails proc.ProcError)
    (example
      ()
      (given (proc (argv "/bin/x") (exited 0)) (proc (argv "/bin/x") (exited 0)))
      =>
      (new proc.Result (exit (proc.Exited 0)) (stdout "") (stderr "")))
    (body (proc.run (list "/bin/x") "" None (list)))))
