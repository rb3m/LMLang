(module bin-overflow-sub
  (purpose "Overflow of - is the fault E-OVERFLOW (exit 70), even with --no-contracts.")
  (use io)
  (fn calc
    (purpose "Overflowing arithmetic.")
    (sig (a Int) (b Int) -> Int)
    (body (- a b)))
  (fn main
    (purpose "Entry.")
    (sig -> Int)
    (eff io.out)
    (body (let ((u (io.print "before"))) (calc -9223372036854775807 2)))))
