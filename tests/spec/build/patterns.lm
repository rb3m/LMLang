(module patterns
  (purpose "List patterns and do in a binary.")
  (use io str)
  (fn describe
    (purpose "Classify a list by shape.")
    (sig (xs (List Int)) -> Str)
    (example ((list)) => "empty")
    (example ((list 7)) => "one 7")
    (example ((list 0 5 6)) => "zero-first")
    (example ((list 1 2)) => "second-two")
    (example ((list 1 3)) => "many")
    (body
      (match
        xs
        ((list) "empty")
        ((list x) (str.concat "one " (str.from-int x)))
        ((cons 0 rest) "zero-first")
        ((cons h (cons 2 t)) "second-two")
        (_ "many"))))
  (fn main
    (purpose "Entry.")
    (sig -> Unit)
    (eff io.out)
    (body
      (do
        (io.print (describe (list)))
        (io.print (describe (list 7)))
        (io.print (describe (list 0 1)))
        (io.print (describe (list 9 2 4)))
        (io.print (describe (list 1 1)))
        (io.print (str.join (str.split "a-b--c" "-") "+"))
        (io.print (match (str.to-int "12x") ((Some n) (str.from-int n)) (None "not a number")))))))
