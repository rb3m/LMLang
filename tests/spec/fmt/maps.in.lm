(module maps (purpose "mapof and setof print like other forms; source order is kept.")
  (fn m (purpose "p") (sig -> (Map Str Int))
    (body (mapof ("zeta" 1) ("alpha" 2) ("a-rather-long-key-name" 3) ("another-long-key-name" 4) ("k" 5))))
  (fn s (purpose "p") (sig -> (Set Float)) (body (setof 2.50 1E5 -0.0))))
