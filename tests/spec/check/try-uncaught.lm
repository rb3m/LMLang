(module try-uncaught
  (purpose "p")
  (error Neg (n Int))
  (error Pos (n Int))
  (fn root
    (purpose "p")
    (sig (n Int) -> Int)
    (fails Neg Pos)
    (body (if (< n 0) (fail Neg n) (fail Pos n))))
  (fn safe
    (purpose "p")
    (sig (n Int) -> Int)
    (body (try (root n) (catch Neg (k) k)))))
