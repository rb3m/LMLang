(module mock-proc-outcome-position
  (purpose "Validate subprocess script metadata: outcome-position.")
  (use proc)
  (fn f
    (purpose "Invoke one scripted process.")
    (sig (value Str) -> proc.Result)
    (eff proc.run)
    (fails proc.ProcError)
    (example
      ("x")
      (given (proc (argv "/bin/x") (exited 0) (stdin "")))
      =>
      (fail proc.ProcError "not-found"))
    (body (proc.run (list "/bin/x") "" None (list)))))
