(module mock-proc-int-overflow
  (purpose "Validate subprocess script metadata: int-overflow.")
  (use proc)
  (fn f
    (purpose "Invoke one scripted process.")
    (sig (value Str) -> proc.Result)
    (eff proc.run)
    (fails proc.ProcError)
    (example
      ("x")
      (given (proc (argv "/bin/x") (exited (+ 9223372036854775807 1))))
      =>
      (fail proc.ProcError "not-found"))
    (body (proc.run (list "/bin/x") "" None (list)))))
