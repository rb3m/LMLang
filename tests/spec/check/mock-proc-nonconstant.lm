(module mock-proc-nonconstant
  (purpose "Validate subprocess script metadata: nonconstant.")
  (use proc)
  (fn f
    (purpose "Invoke one scripted process.")
    (sig (value Str) -> proc.Result)
    (eff proc.run)
    (fails proc.ProcError)
    (example ("x") (given (proc (argv value) (exited 0))) => (fail proc.ProcError "not-found"))
    (body (proc.run (list "/bin/x") "" None (list)))))
