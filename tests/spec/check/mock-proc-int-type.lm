(module mock-proc-int-type
  (purpose "Validate subprocess script metadata: int-type.")
  (use proc)
  (fn f
    (purpose "Invoke one scripted process.")
    (sig (value Str) -> proc.Result)
    (eff proc.run)
    (fails proc.ProcError)
    (example ("x") (given (proc (argv "/bin/x") (exited "0"))) => (fail proc.ProcError "not-found"))
    (body (proc.run (list "/bin/x") "" None (list)))))
