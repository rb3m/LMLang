(module mock-proc-bad-outcome
  (purpose "Validate subprocess script metadata: bad-outcome.")
  (use proc)
  (fn f
    (purpose "Invoke one scripted process.")
    (sig (value Str) -> proc.Result)
    (eff proc.run)
    (fails proc.ProcError)
    (example ("x") (given (proc (argv "/bin/x") (unknown 0))) => (fail proc.ProcError "not-found"))
    (body (proc.run (list "/bin/x") "" None (list)))))
