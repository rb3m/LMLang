(module mock-proc-signaled-output
  (purpose "Validate subprocess script metadata: signaled-output.")
  (use proc)
  (fn f
    (purpose "Invoke one scripted process.")
    (sig (value Str) -> proc.Result)
    (eff proc.run)
    (fails proc.ProcError)
    (example
      ("x")
      (given (proc (argv "/bin/x") (signaled 15 (stdout ""))))
      =>
      (fail proc.ProcError "not-found"))
    (body (proc.run (list "/bin/x") "" None (list)))))
