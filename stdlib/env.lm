(module env
  (purpose "Read-only environment access.")
  (notes "An empty name or one containing = or NUL gives None. A set-but-empty variable gives Some of the empty string. Invalid UTF-8 in values becomes U+FFFD per invalid sequence, as in io.args.")
  (export lookup)
  (fn lookup
    (purpose "Look up an environment variable; None for unset or invalid names.")
    (sig (name Str) -> (Opt Str))
    (eff env.read)
    (body (prim "env.lookup"))))
