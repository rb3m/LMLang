(module proc
  (purpose "Bounded POSIX subprocesses with explicit arguments and environment.")
  (notes "POSIX only; no shell, PATH lookup, expansion or interpreter fallback. None cwd inherits the current directory. No NUL or duplicate/empty env keys; env names cannot contain =. Strict UTF-8 output. Limits: 30 s, 8 MiB stdin, 8 MiB combined output, 64 KiB argv+env. Timeout or output overflow kills the process group; effects do not sandbox children. Examples use ordered (given (proc (argv ...) (exited N ...))) scripts; calls must match argv, stdin, cwd and ordered env exactly.")
  (use fs str)
  (export Exit ProcError Result run which)
  (type Exit (sum (Exited (code Int)) (Signaled (signal Int))))
  (type Result (rec (exit Exit) (stdout Str) (stderr Str)))
  (error ProcError (msg Str))
  (fn run
    (purpose "Run nonempty argv with absolute argv[0] and exactly the supplied child environment.")
    (sig (argv (List Str)) (stdin Str) (cwd (Opt Str)) (env (List (Pair Str Str))) -> Result)
    (eff proc.run)
    (fails ProcError)
    (body (prim "proc.run")))
  (fn which
    (purpose
      "Find the first existing non-directory entry in absolute dirs; skips PATH and permission checks.")
    (sig (name Str) (dirs (List Str)) -> (Opt Str))
    (eff fs.read)
    (fails fs.IoError)
    (body (if (or (= name "") (str.contains name "/")) None (which-in name dirs))))
  (fn which-in
    (purpose "Search remaining directories without reading the host PATH.")
    (sig (name Str) (dirs (List Str)) -> (Opt Str))
    (eff fs.read)
    (fails fs.IoError)
    (body
      (match
        dirs
        ((list) None)
        (
          (cons directory remaining)
          (if
            (str.starts-with directory "/")
            (let
              ((path (str.concat (if (= directory "/") "" directory) (str.concat "/" name))))
              (if
                (and (fs.exists path) (not (fs.is-dir path)))
                (Some path)
                (which-in name remaining)))
            (which-in name remaining)))))))
