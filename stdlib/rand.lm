(module rand
  (purpose "Seedable SplitMix64 random numbers.")
  (notes "One SplitMix64 stream per execution, seeded as unsigned 64-bit from the supplied signed seed. Effectful examples start with a fresh stream (seed 0 by default). int supports the full signed 64-bit span.")
  (export float int)
  (fn float
    (purpose "Uniform random Float in [0, 1) using 53 random bits.")
    (sig -> Float)
    (eff rand)
    (body (prim "rand.float")))
  (fn int
    (purpose
      "Uniform Int in inclusive lo..hi; requires lo <= hi and consumes a draw even when lo = hi.")
    (sig (lo Int) (hi Int) -> Int)
    (eff rand)
    (requires (<= lo hi))
    (body (prim "rand.int"))))
