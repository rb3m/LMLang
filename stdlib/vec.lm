(module vec
  (purpose "Persistent immutable indexed collections backed by a 32-way trie with a tail.")
  (export at empty fold from-list last map nth pop push put repeat set size tabulate to-list)
  (fn at
    (purpose "The element at zero-based index i, or None out of range.")
    (sig (v (Vec a)) (i Int) -> (Opt a))
    (example ((vecof 5 6) 1) => (Some 6))
    (example ((vecof 5) -1) => None)
    (example ((vecof 5) 1) => None)
    (body (prim "vec.at")))
  (fn empty
    (purpose "An empty vector.")
    (sig -> (Vec a))
    (example () => (vecof))
    (body (prim "vec.empty")))
  (fn fold
    (purpose "Combine elements in increasing index order, starting from init.")
    (sig (v (Vec a)) (init b) (step (Fn (b a) b)) -> b)
    (example ((vecof 1 2 3) 0 (lam ((acc Int) (x Int)) (+ (* acc 10) x))) => 123)
    (example ((vecof) 7 +) => 7)
    (body (prim "vec.fold")))
  (fn from-list
    (purpose "The vector of the given list in order.")
    (sig (xs (List a)) -> (Vec a))
    (example ((list 1 2)) => (vecof 1 2))
    (example ((list)) => (vecof))
    (body (prim "vec.from-list")))
  (fn last
    (purpose "The last element, or None when empty.")
    (sig (v (Vec a)) -> (Opt a))
    (example ((vecof 1 2)) => (Some 2))
    (example ((vecof)) => None)
    (body (prim "vec.last")))
  (fn map
    (purpose "Apply f to each element in increasing index order.")
    (sig (v (Vec a)) (f (Fn (a) b)) -> (Vec b))
    (example ((vecof 1 2) (lam ((x Int)) (* x 2))) => (vecof 2 4))
    (body (prim "vec.map")))
  (fn nth
    (purpose "The element at zero-based index i; fails OutOfRange for invalid indices.")
    (sig (v (Vec a)) (i Int) -> a)
    (fails OutOfRange)
    (example ((vecof 5 6) 1) => 6)
    (example ((vecof 5) -1) => (fail OutOfRange))
    (example ((vecof 5) 1) => (fail OutOfRange))
    (body (prim "vec.nth")))
  (fn pop
    (purpose "A vector without its last element, or None when empty.")
    (sig (v (Vec a)) -> (Opt (Vec a)))
    (example ((vecof 1 2)) => (Some (vecof 1)))
    (example ((vecof 1)) => (Some (vecof)))
    (example ((vecof)) => None)
    (body (prim "vec.pop")))
  (fn push
    (purpose "A vector with x appended, sharing its unchanged structure.")
    (sig (v (Vec a)) (x a) -> (Vec a))
    (example ((vecof 1 2) 3) => (vecof 1 2 3))
    (example ((vecof) 1) => (vecof 1))
    (body (prim "vec.push")))
  (fn put
    (purpose "A vector with index i replaced by x; fails OutOfRange for invalid indices.")
    (sig (v (Vec a)) (i Int) (x a) -> (Vec a))
    (fails OutOfRange)
    (example ((vecof 1 2) 0 9) => (vecof 9 2))
    (example ((vecof 1) -1 9) => (fail OutOfRange))
    (example ((vecof 1) 1 9) => (fail OutOfRange))
    (body (prim "vec.put")))
  (fn repeat
    (purpose "A vector containing n copies of x; negative n gives empty.")
    (sig (n Int) (x a) -> (Vec a))
    (example (3 "a") => (vecof "a" "a" "a"))
    (example (-1 7) => (vecof))
    (body (prim "vec.repeat")))
  (fn set
    (purpose "A vector with index i replaced by x, or None out of range.")
    (sig (v (Vec a)) (i Int) (x a) -> (Opt (Vec a)))
    (example ((vecof 1 2) 0 9) => (Some (vecof 9 2)))
    (example ((vecof 1) -1 9) => None)
    (example ((vecof 1) 1 9) => None)
    (body (prim "vec.set")))
  (fn size
    (purpose "The number of elements.")
    (sig (v (Vec a)) -> Int)
    (example ((vecof 1 2)) => 2)
    (example ((vecof)) => 0)
    (body (prim "vec.size")))
  (fn tabulate
    (purpose "A vector of f applied to indices 0 through n minus one; negative n gives empty.")
    (sig (n Int) (f (Fn (Int) a)) -> (Vec a))
    (example (3 (lam ((i Int)) (* i 2))) => (vecof 0 2 4))
    (example (-1 (lam ((i Int)) i)) => (vecof))
    (body (prim "vec.tabulate")))
  (fn to-list
    (purpose "The vector elements as a list in index order.")
    (sig (v (Vec a)) -> (List a))
    (example ((vecof 1 2)) => (list 1 2))
    (example ((vecof)) => (list))
    (body (prim "vec.to-list"))))
