(module http
  (purpose "HTTP client, request records and strict query decoding.")
  (notes "Client: verified HTTPS, plaintext HTTP only on loopback. ASCII URLs with valid escapes; no userinfo or fragments. Methods GET HEAD POST PUT PATCH DELETE OPTIONS. Reserved headers: Host, Content-Length, Transfer-Encoding, Connection. No redirects, proxies or network examples. Limits: 5 s connect, 8 MiB request headers+body and response body, 64 KiB/100 response headers. Response body is strict UTF-8; headers are sorted lowercase names, retaining duplicates. Server setup: lm help serve.")
  (use str)
  (export
    BadEncoding
    HttpError
    Request
    Response
    fetch
    query-pairs
    request
    request-within
    url-decode)
  (type
    Request
    (rec (method Str) (target Str) (query Str) (headers (List (Pair Str Str))) (body Str)))
  (type Response (rec (status Int) (headers (List (Pair Str Str))) (body Str)))
  (error BadEncoding (s Str))
  (error HttpError (url Str) (msg Str))
  (fn fetch
    (purpose "GET with empty body, no caller headers and a 30-second total deadline.")
    (sig (url Str) -> Response)
    (eff net.http)
    (fails HttpError)
    (body (request "GET" url (list) "")))
  (fn query-fields
    (purpose "Decode nonempty query fields in order.")
    (sig (fields (List Str)) -> (List (Pair Str Str)))
    (fails BadEncoding)
    (example ((list)) => (list))
    (example
      ((list "" "a=one+two" "a=%2B" "flag"))
      =>
      (list (pair "a" "one two") (pair "a" "+") (pair "flag" "")))
    (body
      (match
        fields
        ((list) (list))
        (
          (cons field rest)
          (if
            (= field "")
            (query-fields rest)
            (match
              (str.split field "=")
              ((list) (query-fields rest))
              (
                (cons key values)
                (cons
                  (pair
                    (url-decode (str.replace key "+" " "))
                    (url-decode (str.replace (str.join values "=") "+" " ")))
                  (query-fields rest)))))))))
  (fn query-pairs
    (purpose "Decode query fields, keeping duplicates and replacing plus with space.")
    (sig (q Str) -> (List (Pair Str Str)))
    (fails BadEncoding)
    (example ("") => (list))
    (example
      ("&a=one+two&a=%2B&flag&b=x=y&")
      =>
      (list (pair "a" "one two") (pair "a" "+") (pair "flag" "") (pair "b" "x=y")))
    (example ("x=%FF") => (fail BadEncoding "%FF"))
    (body (query-fields (str.split q "&"))))
  (fn request
    (purpose "Send one request with a 30-second total deadline. Non-2xx statuses are results.")
    (sig (method Str) (url Str) (headers (List (Pair Str Str))) (body Str) -> Response)
    (eff net.http)
    (fails HttpError)
    (body (request-within method url headers body 30)))
  (fn request-within
    (purpose "Send one request; a deadline outside 1..600 seconds fails before network I/O.")
    (sig (method Str) (url Str) (headers (List (Pair Str Str))) (body Str) (secs Int) -> Response)
    (eff net.http)
    (fails HttpError)
    (body (prim "http.request-within")))
  (fn url-decode
    (purpose "Decode percent escapes as strict UTF-8; keep plus signs.")
    (sig (s Str) -> Str)
    (fails BadEncoding)
    (example ("a%20b+c") => "a b+c")
    (example ("%C3%A9") => "é")
    (example ("%GG") => (fail BadEncoding "%GG"))
    (example ("%FF") => (fail BadEncoding "%FF"))
    (body (prim "http.url-decode"))))
