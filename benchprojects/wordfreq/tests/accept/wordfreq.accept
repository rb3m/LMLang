(scenarios
  (scenario "ASCII words and separators"
    (status proposed)
    (why "Words are maximal ASCII letter or digit runs; Unicode, underscores and punctuation separate.")
    (run wordfreq.words "Cat,CAT! a1_2 éZ😀end")
    (expect (list "cat" "cat" "a1" "2" "z" "end")))
  (scenario "Frequency order and limit"
    (status proposed)
    (why "Higher counts come first; equal counts use ascending word order; N truncates results.")
    (run wordfreq.top-lines "b A b a C" 2)
    (expect (list "2 a" "2 b")))
  (scenario "Sample frequencies"
    (status proposed)
    (why "The supplied sample produces six distinct words with the requested count and tie ordering.")
    (run wordfreq.top-lines "the cat and the hat\nThe CAT sat; the end.\n" 10)
    (expect (list "4 the" "2 cat" "1 and" "1 end" "1 hat" "1 sat")))
  (scenario "Empty input"
    (status proposed)
    (why "No ASCII words means no output lines.")
    (run wordfreq.top-lines "---é😀" 10)
    (expect (list)))
  (scenario "Default limit"
    (status proposed)
    (why "Omitting N selects ten words.")
    (run wordfreq.parse-limit (list))
    (expect (Some 10)))
  (scenario "Invalid limit"
    (status proposed)
    (why "Zero is not a positive integer and must be rejected.")
    (run wordfreq.parse-limit (list "0"))
    (expect None))
  (scenario "Missing FILE output"
    (status proposed)
    (why "No FILE prints the exact usage line.")
    (allow io.out)
    (allow fs.read)
    (run wordfreq.run-args (list))
    (expect-out "usage: wordfreq FILE [N]\n"))
  (scenario "Missing FILE status"
    (status proposed)
    (why "No FILE returns exit status two.")
    (allow io.out)
    (allow fs.read)
    (run wordfreq.run-args (list))
    (expect 2))
  (scenario "Invalid N output"
    (status proposed)
    (why "A nonpositive N reports the specified error before attempting file I/O.")
    (allow io.out)
    (allow fs.read)
    (run wordfreq.run-args (list "../sample.txt" "0"))
    (expect-out "error: N must be a positive integer\n"))
  (scenario "Invalid N status"
    (status proposed)
    (why "A malformed N returns exit status two.")
    (allow io.out)
    (allow fs.read)
    (run wordfreq.run-args (list "../sample.txt" "abc"))
    (expect 2))
  (scenario "Unreadable FILE output"
    (status proposed)
    (why "A nonexistent file reports the exact path in the required error message.")
    (allow io.out)
    (allow fs.read)
    (run wordfreq.run-args (list "missing-wordfreq-file.txt"))
    (expect-out "error: cannot read missing-wordfreq-file.txt\n"))
  (scenario "Unreadable FILE status"
    (status proposed)
    (why "A nonexistent file returns exit status one.")
    (allow io.out)
    (allow fs.read)
    (run wordfreq.run-args (list "missing-wordfreq-file.txt"))
    (expect 1))
  (scenario "Read sample with default N"
    (status proposed)
    (why "Reading the supplied sample prints exactly the six expected frequency lines.")
    (allow io.out)
    (allow fs.read)
    (run wordfreq.run-args (list "../sample.txt"))
    (expect-out "4 the\n2 cat\n1 and\n1 end\n1 hat\n1 sat\n")))
